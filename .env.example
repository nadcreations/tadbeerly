# Development uses a user-owned Postgres cluster on port 5435. See the README:
# the system cluster on 5433 needs root to add a login role.
DATABASE_URL="postgresql://nadcreations:tadbeerly_dev@127.0.0.1:5435/tadbeerly"
TEST_DATABASE_URL="postgresql://nadcreations:tadbeerly_dev@127.0.0.1:5435/tadbeerly_test"

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-in-production-0000000000000000000000000000000000000000"

# Encrypts stored TOTP secrets. Falls back to SESSION_SECRET when unset, but
# set it separately so rotating session keys does not invalidate everyone's
# second factor. Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=""

# Base URL used when building links inside notification emails.
APP_URL="http://localhost:3000"

# --- File storage ----------------------------------------------------------
# sharepoint | netlify-blobs | local. Unset means Netlify Blobs on Netlify and
# local disk anywhere else. SharePoint is never inferred — it needs a tenant, a
# site and a secret, so it has to be asked for.
# STORAGE_BACKEND="sharepoint"

# Where local disk keeps files, when that backend is in use.
# STORAGE_ROOT="./storage"

# SharePoint, via an Entra ID app registration holding Sites.Selected with the
# "write" role on this one site. No user signs in: Tadbeerly decides who may read a
# document, and SharePoint only holds the bytes.
# SHAREPOINT_TENANT_ID=""
# SHAREPOINT_CLIENT_ID=""
# SHAREPOINT_CLIENT_SECRET=""
# SHAREPOINT_SITE_URL="https://contoso.sharepoint.com/sites/Tadbeerly"
# SHAREPOINT_LIBRARY="Documents"      # the library's display name
# SHAREPOINT_ROOT="tadbeerly"         # optional folder inside it

# --- Email notifications ---------------------------------------------------
# console | smtp | resend. "console" prints instead of sending, so nothing
# escapes a development machine by accident.
EMAIL_TRANSPORT="console"
EMAIL_FROM="tadbeerly@example.com"
EMAIL_FROM_NAME="Tadbeerly"

# SMTP suits a long-running server. It suits a serverless one badly: the
# handshake has to finish inside the function's lifetime, and Microsoft 365 in
# particular now refuses basic-auth SMTP tenant-wide —
#   535 5.7.139 SmtpClientAuthentication is disabled for the Tenant
# which no setting on this side can get past.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # true for implicit TLS on 465
# SMTP_USER=""
# SMTP_PASSWORD=""

# The right choice anywhere serverless: one HTTPS call, no ports to open and no
# handshake to time out. EMAIL_FROM must be on a domain verified in Resend —
# an unverified sender is rejected outright rather than delivered to spam.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=""

# Microsoft 365 through Graph, as the same Entra app registration that stores
# documents — so the mail leaves from the organization's own mailbox, over
# HTTPS, with no SMTP to be refused or time out. Credentials fall back to the
# SHAREPOINT_ ones, so a tenant using both needs no second copy of the secret.
#
# Requires the Mail.Send *application* permission on that app registration,
# added and consented by an administrator. Check whether it is there with
# `npm run email:graph-check`, which reads the grant out of the token rather
# than discovering it missing as a 403 in the outbox hours later.
#
# Mail.Send is tenant-wide: it lets the app send as any mailbox. Restrict it to
# this one with an Application Access Policy.
# EMAIL_TRANSPORT=graph
# EMAIL_FROM="documents@your-tenant.com"   # must be a real mailbox
# GRAPH_MAIL_SENDER=""                     # only if it differs from EMAIL_FROM
# GRAPH_TENANT_ID=""                       # defaults to SHAREPOINT_TENANT_ID
# GRAPH_CLIENT_ID=""                       # defaults to SHAREPOINT_CLIENT_ID
# GRAPH_CLIENT_SECRET=""                   # defaults to SHAREPOINT_CLIENT_SECRET

# Shared secret for POST /api/cron/notifications, which drains the outbox and
# raises overdue reminders. Unset means the endpoint is disabled, and — since
# the immediate send after an action is best-effort — nothing will ever retry a
# message that failed the first time. Set it in any deployment that sends mail.
# netlify/functions/notifications.ts calls the endpoint every five minutes and
# reads this same variable.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
